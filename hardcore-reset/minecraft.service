[Unit]
Description=Minecraft Forge 26.2 Hardcore Reset Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/minecraft-26-2
ExecStart=/bin/bash /home/ubuntu/minecraft-26-2/server-wrapper.sh
Restart=on-failure
RestartSec=10
# Configuration/deletion failures require operator intervention, not a restart loop.
RestartPreventExitStatus=78
# Send TERM to the wrapper; it forwards TERM and waits for the full Java process group.
KillMode=mixed
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
